{
  "additionalProperties": false,
  "description": "One source-audio to target-text example with complete lineage.",
  "properties": {
    "audio_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Audio Path"
    },
    "audio_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Audio Sha256"
    },
    "domain": {
      "enum": [
        "conversation",
        "industrial",
        "general_read"
      ],
      "title": "Domain",
      "type": "string"
    },
    "duration_s": {
      "exclusiveMinimum": 0,
      "maximum": 30,
      "title": "Duration S",
      "type": "number"
    },
    "filter_decision": {
      "default": "unreviewed",
      "enum": [
        "unreviewed",
        "keep",
        "reject"
      ],
      "title": "Filter Decision",
      "type": "string"
    },
    "filter_reasons": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Filter Reasons",
      "type": "array"
    },
    "generation_config_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Generation Config Sha256"
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9._-]+$",
      "title": "Id",
      "type": "string"
    },
    "materialization_status": {
      "default": "metadata_only",
      "enum": [
        "metadata_only",
        "ready"
      ],
      "title": "Materialization Status",
      "type": "string"
    },
    "quality_flags": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Quality Flags",
      "type": "array"
    },
    "sample_rate": {
      "default": 16000,
      "exclusiveMinimum": 0,
      "title": "Sample Rate",
      "type": "integer"
    },
    "semantic_group_id": {
      "title": "Semantic Group Id",
      "type": "string"
    },
    "source_audio_ref": {
      "title": "Source Audio Ref",
      "type": "string"
    },
    "source_dataset": {
      "title": "Source Dataset",
      "type": "string"
    },
    "source_item_id": {
      "title": "Source Item Id",
      "type": "string"
    },
    "source_license": {
      "title": "Source License",
      "type": "string"
    },
    "source_locale": {
      "title": "Source Locale",
      "type": "string"
    },
    "source_revision": {
      "title": "Source Revision",
      "type": "string"
    },
    "speaker_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Speaker Id"
    },
    "split": {
      "enum": [
        "train",
        "validation",
        "test"
      ],
      "title": "Split",
      "type": "string"
    },
    "src_lang": {
      "enum": [
        "vi",
        "en",
        "zh",
        "ko"
      ],
      "title": "Src Lang",
      "type": "string"
    },
    "src_text": {
      "minLength": 1,
      "title": "Src Text",
      "type": "string"
    },
    "target_kind": {
      "enum": [
        "gold",
        "teacher",
        "synthetic"
      ],
      "title": "Target Kind",
      "type": "string"
    },
    "teacher_chain_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Teacher Chain Sha256"
    },
    "teacher_generated_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Teacher Generated At"
    },
    "teacher_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Teacher Id"
    },
    "teacher_license": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Teacher License"
    },
    "teacher_revision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Teacher Revision"
    },
    "tgt_lang": {
      "enum": [
        "vi",
        "en",
        "zh",
        "ko"
      ],
      "title": "Tgt Lang",
      "type": "string"
    },
    "tgt_text": {
      "minLength": 1,
      "title": "Tgt Text",
      "type": "string"
    }
  },
  "required": [
    "id",
    "source_item_id",
    "semantic_group_id",
    "source_locale",
    "source_audio_ref",
    "duration_s",
    "src_lang",
    "tgt_lang",
    "src_text",
    "tgt_text",
    "target_kind",
    "domain",
    "split",
    "source_dataset",
    "source_revision",
    "source_license"
  ],
  "title": "ManifestRecord",
  "type": "object"
}
